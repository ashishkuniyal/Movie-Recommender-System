# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
# .env.example is intentionally NOT ignored — it's a safe template

# ── Model files (large binaries >100MB) ────────────────────────────────────────
model/*.pkl
!model/.gitkeep

# ── Dataset (large CSVs) ──────────────────────────────────────────────────────
data/*.csv
!data/.gitkeep

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
